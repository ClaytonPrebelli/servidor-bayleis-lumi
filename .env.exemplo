# Porta. O Render injeta a dele; 3001 e' o padrao para rodar na sua maquina.
PORT=3001

# Endereco da API da Lumi Makeup.
#
# O Node fala com a API para guardar e recuperar a sessao do WhatsApp. O banco
# fica fechado para a internet, entao esta URL e' o unico caminho do Render ate
# a loja - e precisa ser https e publica.
URL_DA_API=https://api.lumimakeup.com.br

# Mesmo valor que a API le de ExternalServices:Baileys:SegredoCompartilhado.
#
# Em desenvolvimento o Node sobe sem ele, e o painel mostra que o WhatsApp
# esta desligado. Em producao o segredo e obrigatorio: sem ele, a API
# registraria o stub e nenhum aviso de pedido sairia.
BAILEYS_SEGREDO_COMPARTILHADO=troque-este-valor

# true deixa o log so com conexao, envio e erro.
BAILEYS_SILENCIOSO=false

# De quanto em quanto tempo, em milissegundos, a sessao alterada vai para a
# API. O padrao e' 2 minutos.
#
# O Baileys altera chaves a cada mensagem. Gravar a cada alteracao seria trafego
# inutil; agrupar reduz para uma gravacao por intervalo, e nada se perde de
# verdade porque a sessao tambem e gravada no encerramento.
INTERVALO_DE_GRAVACAO_EM_MS=120000
