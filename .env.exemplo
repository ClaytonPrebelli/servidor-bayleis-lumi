# Porta local. O Node escuta so em 127.0.0.1; quem entra pela internet e o IIS,
# por HTTPS, no subdominio whats.lumimakeup.com.br.
PORT=3001

# Mesmo valor que a API le de ExternalServices:Baileys. Em producao os dois
# lados vem da mesma variavel de ambiente do servidor.
BAILEYS_SEGREDO_COMPARTILHADO=troque-este-valor

# true deixa o log so com conexao, envio e erro.
BAILEYS_SILENCIOSO=false
