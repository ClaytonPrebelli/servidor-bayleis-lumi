<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Site do Node do Baileys (whats.lumimakeup.com.br).

    POR QUE ESTE SITE EXISTE, SENDO QUE A API FALA DIRETO COM O NODE

    A API chama 127.0.0.1:3001 e nao passa por aqui. Este site existe so para
    o diagnostico: ver, pelo navegador, se o Node esta no ar e se o numero esta
    pareado. Por isso as regras abaixo bloqueiam o resto.

    Se voce nao quiser nem esse diagnostico, apague o site no IIS. Nada do
    funcionamento do WhatsApp depende dele.

    O QUE NAO PODE PASSAR

      /pareamento  devolve o QR do numero da loja. Exposto, qualquer pagina
                   aberta no navegador da administradora leria o QR - e o QR e
                   o proprio acesso a conta. A tela do painel pede o QR a API,
                   e a API repassa. O segredo nunca chega ao navegador.

      /enviar      so a API usa, e so com o segredo. Publicado, daria a chance
                   de tentar mandar mensagem como a loja.

      /dados       a sessao do WhatsApp em disco. Quem baixar esses arquivos
                   connecta no numero da loja sem precisar de nenhum segredo.

    O QUE FICA: /saude e /status, que respondem "esta no ar" e "esta pareado".
  -->
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Bloquear pareamento" stopProcessing="true">
          <match url="^pareamento" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Nao existe" />
        </rule>

        <rule name="Bloquear envio" stopProcessing="true">
          <match url="^enviar" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Nao existe" />
        </rule>

        <rule name="Bloquear a sessao em disco" stopProcessing="true">
          <match url="^dados(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Nao existe" />
        </rule>

        <rule name="Proxy para o Node" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <proxy>
      <forwarding name="baileys">
        <target>127.0.0.1:3001</target>
      </forwarding>
    </proxy>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Bloqueio em profundidade, para o pedido nem chegar na regra acima. -->
          <add segment="dados" />
          <add segment="src" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
